# Manual npm/Docker runs stay loopback-only unless changed; macOS `service install` defaults to 0.0.0.0.
HERMES_YAOYAO_HOST=127.0.0.1
HERMES_YAOYAO_PORT=15300
# Comma-separated additional DNS names. Localhost and active private IP literals are allowed automatically.
HERMES_YAOYAO_ALLOWED_HOSTS=
# For manual LAN access set HOST=0.0.0.0 and either configure TLS or explicitly enable trusted-LAN HTTP below.
HERMES_YAOYAO_ALLOW_INSECURE_LAN=0
# 管理后台：独立端口，只允许管理员登录，默认只在本机可访问。见 docs/admin-console.md。
# YAOYAO_ADMIN_PORT=15301            # off 关闭后台
# YAOYAO_ADMIN_HOST=127.0.0.1        # 非回环地址时必须同时设置来源白名单和 TLS
# YAOYAO_ADMIN_ALLOW_IPS=10.0.0.5,192.168.1.0/24
# Hermes 已内置在夭夭服务中，不再连接 9119。HERMES_YAOYAO_UPSTREAM*、HERMES_YAOYAO_SUPERVISE_DASHBOARD、
# HERMES_YAOYAO_BRIDGE_*、HERMES_YAOYAO_CHAT_CACHE_MODE 已停用，设置后启动时只提示、不生效。
# 首次启动会只读导入 ~/.hermes；可用 YAOYAO_IMPORT_HERMES_HOME 指定其他目录，YAOYAO_IMPORT_HERMES=0 跳过导入。
# YAOYAO_IMPORT_HERMES_HOME=/Users/you/.hermes
# HERMES_YAOYAO_TLS_CERT=/absolute/path/to/cert.pem
# HERMES_YAOYAO_TLS_KEY=/absolute/path/to/key.pem
# YAOYAO_HOME=/Users/you/.yaoyao
# iOS 后台通知使用 APNs Token Key。四项中前三项必须同时配置，.p8 不得放入仓库。
# 任一 APNs 环境变量存在时，系统管理中的本地路径配置为只读；全部留空才可由 Web 管理。
# HERMES_YAOYAO_APNS_KEY_FILE=/absolute/path/to/AuthKey_XXXXXXXXXX.p8
# HERMES_YAOYAO_APNS_KEY_ID=XXXXXXXXXX
# HERMES_YAOYAO_APNS_TEAM_ID=GMU6W5FKQ6
# HERMES_YAOYAO_APNS_TOPIC=cn.samien.yaoyao.hermes
# Android 后台通知使用 FCM HTTP v1。服务账号 JSON 必须位于仓库外并建议设为 0600。
# 任一 FCM 环境变量存在时，系统管理中的 FCM 配置为只读；三项必须完整匹配。
# HERMES_YAOYAO_FCM_SERVICE_ACCOUNT_FILE=/absolute/path/to/firebase-service-account.json
# HERMES_YAOYAO_FCM_PROJECT_ID=your-firebase-project-id
# HERMES_YAOYAO_FCM_PACKAGE_NAME=cn.samien.yaoyao.hermes
# Bot 模式可选 OpenViking 记忆 Provider。三项同时存在时由环境变量管理并强制启用。
# HERMES_YAOYAO_OPENVIKING_URL=http://127.0.0.1:1933
# HERMES_YAOYAO_OPENVIKING_ACCOUNT_ID=your-openviking-account
# HERMES_YAOYAO_OPENVIKING_ADMIN_KEY=your-openviking-admin-key
# 固定 Git 发布源。系统更新只接受这里发现的 vX.Y.Z 标签，不接受浏览器指定仓库。
# HERMES_YAOYAO_RELEASE_SOURCE=https://github.com/Lsamien/yaoyao.git
# HERMES_YAOYAO_RELEASE_ROOT=/Users/you/.local/share/hermes-yaoyao
# 系统更新默认仅允许从本机浏览器触发；可信网络确有需要时才显式开启。
# HERMES_YAOYAO_ALLOW_REMOTE_UPDATE=0
