+extension LaunchSmokeTests {
+    func testLatencyCompare() throws {
+        continueAfterFailure = false
+        let configData = try Data(contentsOf: URL(string: "http://127.0.0.1:18959/config")!)
+        let config = try JSONSerialization.jsonObject(with: configData) as! [String: [String: String]]
+        let cases = [("yaoyao", 0, "short", 6), ("openmausbot", 0, "short", 6),
+                     ("openmausbot", 160, "short", 6), ("yaoyao", 160, "short", 6),
+                     ("yaoyao", 160, "long", 1), ("openmausbot", 160, "long", 1)]
+        for (product, delay, kind, count) in cases {
+            let group = "series-\(product)-\(delay)-\(kind)"
+            _ = try Data(contentsOf: URL(string: "http://127.0.0.1:18959/scenario?delay=\(delay)&run=\(group)-setup")!)
+            let isYY = product == "yaoyao"
+            let settings = config[isYY ? "yy" : "omb"]!
+            let app = isYY ? XCUIApplication() : XCUIApplication(bundleIdentifier: "cn.samien.hermes.bot")
+            app.launchEnvironment["LATENCY_URL"] = settings["url"]
+            app.launchEnvironment["LATENCY_TOKEN"] = settings["token"]
+            app.launchEnvironment["LATENCY_RUN"] = group
+            app.launchArguments = ["-AppleLanguages", "(zh-Hans)", "-AppleLocale", "zh_CN"]
+            app.launch()
+            let chat = isYY ? app.descendants(matching: .any)["workspace.conversation.\(settings["conversationId"]!)"] : app.buttons.matching(NSPredicate(format: "label CONTAINS %@", "LatencyBot")).firstMatch
+            XCTAssertTrue(chat.waitForExistence(timeout: 20), app.debugDescription)
+            chat.tap()
+            let input = app.descendants(matching: .any)[isYY ? "workspace.message-input" : "message-input"].firstMatch
+            XCTAssertTrue(input.waitForExistence(timeout: 10), app.debugDescription)
+            for number in 1...count {
+                let run = "\(group)-\(number)"
+                _ = try Data(contentsOf: URL(string: "http://127.0.0.1:18959/scenario?delay=\(delay)&run=\(run)")!)
+                input.tap()
+                input.typeText("[latency:\(kind)-\(run)]")
+                let send = app.buttons[isYY ? "workspace.send" : "latency.send"]
+                XCTAssertTrue(send.waitForExistence(timeout: 5), app.debugDescription)
+                send.tap()
+                let expected = "END-\(kind)-\(run)"
+                let reply = app.staticTexts.matching(NSPredicate(format: "label CONTAINS %@", expected)).firstMatch
+                XCTAssertTrue(reply.waitForExistence(timeout: 30), app.debugDescription)
+                if number == count {
+                    let attachment = XCTAttachment(screenshot: app.screenshot()); attachment.name = run; attachment.lifetime = .keepAlways; add(attachment)
+                }
+                Thread.sleep(forTimeInterval: 0.7)
+            }
+            app.terminate()
+        }
+    }
+}
