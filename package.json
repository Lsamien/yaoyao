{
  "name": "yaoyao",
  "version": "0.4.12",
  "private": true,
  "license": "Apache-2.0",
  "description": "夭夭 AI：聊天、多 Agent 团队、文件库与电脑工作空间",
  "type": "module",
  "main": "desktop/main.mjs",
  "engines": {
    "node": ">=24.0.0"
  },
  "bin": {
    "hermes-yaoyao": "./bin/hermes-yaoyao.mjs",
    "yaoyao": "./bin/hermes-yaoyao.mjs"
  },
  "scripts": {
    "dev": "cross-env NODE_ENV=development tsx watch src/server/index.ts",
    "build": "npm run brand:verify && npm run release:verify && vue-tsc -b tsconfig.client.build.json && vite build && tsc -p tsconfig.server.json && node scripts/copy-worker.mjs && node scripts/write-build-info.mjs",
    "start": "cross-env NODE_ENV=production node dist-server/server/index.js",
    "typecheck": "vue-tsc -b && tsc --noEmit -p tsconfig.server.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npm run build && playwright test",
    "test:live": "cross-env HERMES_YAOYAO_LIVE_TEST=1 vitest run tests/live",
    "brand:verify": "node scripts/verify-brand.mjs",
    "release:verify": "node scripts/verify-release.mjs",
    "verify:lifecycle": "node scripts/verify-lifecycle.mjs",
    "test:e2e:workspace": "npm run build && playwright test -c playwright.workspace.config.ts",
    "test:e2e:team-tools": "npm run build && playwright test -c playwright.team-tools.config.ts",
    "desktop:build": "npm run build && node scripts/build-desktop.mjs",
    "desktop:dev": "npm run desktop:build && electron .",
    "desktop:pack": "npm run desktop:build && electron-builder --mac --arm64 --publish never",
    "desktop:test": "node --test desktop/*.test.mjs",
    "runner": "node dist-server/runner/index.js",
    "runner:dev": "tsx src/runner/index.ts",
    "runner:build": "node scripts/build-runner.mjs"
  },
  "dependencies": {
    "@koa/bodyparser": "^5.0.0",
    "@koa/router": "^15.4.0",
    "@types/busboy": "^1.5.4",
    "@types/koa": "^2.15.0",
    "@types/koa-send": "^4.1.6",
    "@types/koa-static": "^4.0.4",
    "@types/markdown-it": "^14.1.2",
    "@types/mime-types": "^2.1.4",
    "@types/node": "^24.10.0",
    "@types/qrcode": "^1.5.6",
    "@types/ws": "^8.18.1",
    "@vicons/ionicons5": "^0.13.0",
    "@vicons/tabler": "^0.13.0",
    "@vitejs/plugin-vue": "^6.0.5",
    "@vue/tsconfig": "^0.9.1",
    "busboy": "^1.6.0",
    "cookie": "^1.0.2",
    "docx-preview": "^0.3.7",
    "dompurify": "^3.2.6",
    "highlight.js": "^11.11.1",
    "idb": "^8.0.3",
    "koa": "^2.15.3",
    "koa-send": "^5.0.1",
    "koa-static": "^5.0.0",
    "markdown-it": "^14.1.0",
    "mime-types": "^3.0.1",
    "naive-ui": "^2.44.1",
    "pdfjs-dist": "^5.7.284",
    "pinia": "^3.0.4",
    "qrcode": "^1.5.4",
    "read-excel-file": "^7.0.3",
    "sass": "^1.99.0",
    "typescript": "~6.0.2",
    "vite": "^8.0.4",
    "vue": "^3.5.32",
    "vue-router": "^4.6.4",
    "vue-tsc": "^3.2.8",
    "ws": "^8.20.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/jsdom": "^21.1.7",
    "@types/supertest": "^6.0.3",
    "@vitest/coverage-v8": "^3.2.4",
    "@vue/test-utils": "^2.4.6",
    "cross-env": "^10.1.0",
    "electron": "43.4.0",
    "electron-builder": "26.15.3",
    "esbuild": "0.28.2",
    "jsdom": "^27.0.1",
    "supertest": "^7.1.4",
    "tsx": "^4.21.0",
    "vitest": "^3.2.4"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Lsamien/yaoyao.git"
  },
  "homepage": "https://github.com/Lsamien/yaoyao"
}
